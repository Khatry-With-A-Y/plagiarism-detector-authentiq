# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored (see the `.env` rule in .gitignore) so the
# real credentials never end up in git history.
#
# Brevo SMTP relay (transactional email) -- used by
# backend/app/utils/mailer.py to send the reviewer-application
# institutional-email verification link.
BREVO_LOGIN=your_login@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-replace-me
BREVO_SENDER=your_verified_sender@example.com

# Frontend base URL embedded in the verification link.
APP_BASE_URL=http://localhost:3000

# "1" = print the verification link to the backend terminal (no real send).
# "0" = actually send via Brevo using the credentials above.
MAIL_DEV_DUMP=0
